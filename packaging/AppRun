#!/bin/sh
# AppImage entry point. SysCleaner is a Python app: GTK/PyGObject come from the host system
# (python3-gi is preinstalled on Linux Mint / Ubuntu / Debian desktops).
HERE="$(dirname "$(readlink -f "$0")")"
unset PYTHONHOME
export PYTHONPATH="$HERE/usr/lib/syscleaner${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m syscleaner "$@"
